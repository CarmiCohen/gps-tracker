<?xml version="1.0" encoding="utf-8"?>
<!-- ISSUE-NOV10.8-O80 part 2: Auto Backup and device transfer from Android 12. Same files as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="device_file" path="datastore/sensor_settings.preferences_pb" />
        <include domain="device_file" path="datastore/forensic_identity.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="device_file" path="datastore/sensor_settings.preferences_pb" />
        <include domain="device_file" path="datastore/forensic_identity.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
